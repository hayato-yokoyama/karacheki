{
  "name": "karacheki",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "APP_VARIANT=development npx expo start --dev-client",
    "device:register": "npx eas-cli device:create",
    "build:device": "npx eas-cli build --profile development --platform ios",
    "build:simulator": "npx eas-cli build --profile ios-simulator --platform ios",
    "build:production": "npx eas-cli build --profile production --platform ios",
    "submit:production": "npx eas-cli submit --profile production --platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:html": "markuplint \"**/*.html\"",
    "generate-themes": "tamagui generate-themes ./theme-builder.ts ./theme-output.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.globalSetup.js"
  },
  "expo": {
    "autolinking": {
      "apple": {
        "buildFromSource": [
          "expo-image-manipulator"
        ]
      }
    }
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "^15.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/cli": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "@tanstack/react-query": "^5.102.8",
    "date-fns": "^4.4.0",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-onboarding-swiper": "^1.4.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7",
    "victory-native": "^42.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "2.5.14",
    "@tamagui/animations-moti": "^2.7.7",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-native-onboarding-swiper": "^1.1.9",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "markuplint": "^4.11.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
